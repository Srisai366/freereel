# Copy to .env and adjust. Never commit .env.
ENVIRONMENT=development

# SQLite for local dev; for Postgres use e.g.
# DATABASE_URL=postgresql://user:password@host:5432/freereel
DATABASE_URL=sqlite:///./freereel.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me-dev-only-change-me-dev-only
JWT_EXPIRE_MINUTES=60

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Set true when running behind Render/Cloudflare so X-Forwarded-For is used for rate limiting
TRUST_PROXY_HEADERS=false
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=5

# Storage: "local" (files under LOCAL_STORAGE_DIR, served at /media) or "s3" (S3 / Cloudflare R2)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
MEDIA_PUBLIC_BASE_URL=http://localhost:8000/media

# S3 / R2 (only when STORAGE_BACKEND=s3)
# R2 endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com, region "auto"
S3_ENDPOINT_URL=
S3_REGION=auto
S3_PUBLIC_BUCKET=freereel-media
S3_PRIVATE_BUCKET=freereel-originals
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Uploads
UPLOAD_TMP_DIR=./tmp_uploads
MAX_POSTER_MB=5
MAX_VIDEO_MB=4096
KEEP_ORIGINALS=true

# Video processing
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
HLS_SEGMENT_SECONDS=6
# Run the worker as a thread inside the API (dev convenience). In production run
# `python -m app.workers.video_worker` as its own process.
RUN_WORKER_IN_PROCESS=false
WORKER_POLL_SECONDS=5
