# Public values only. Anything prefixed NEXT_PUBLIC_ is shipped to browsers — never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=FreeReel

# Optional: server-side URL for the API when it differs from the public one (e.g. inside Docker).
API_INTERNAL_URL=
